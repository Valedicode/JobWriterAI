# LLM + embeddings: set OPENROUTER_API_KEY (preferred). If it is empty, OPENAI_API_KEY is used instead.
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here
# Chat model (OpenRouter slug). If unset, defaults to openai/gpt-4o-mini
LLM_MODEL=deepseek/deepseek-v4.1-flash

# OpenAI key: only needed for voice transcription (OpenRouter has no audio API),
# or as the LLM key when OPENROUTER_API_KEY is not set
# OPENAI_API_KEY=sk-your-openai-api-key-here 

# Other providers (not used yet)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# Web search (required for job research)
TAVILY_API_KEY=your-tavily_api-key

# Database: orchestrator sessions are stored in Postgres when this is set.
# Leave it unset to keep sessions in memory only (every restart loses them).
# Supabase: use the session pooler connection string (port 5432), EU region.
# DATABASE_URL=postgresql://user:password@localhost:5432/jobwriterai
# Sessions, and the CV data in them, are deleted this long after their last activity.
# SESSION_TTL_HOURS=24

# Application Settings
APP_NAME="JobWriterAI"
DEBUG=False
USER_AGENT="JobWriterAI/0.1.0"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# LaTeX PDF export (install Tectonic or a TeX distribution)
# LATEX_COMPILER=tectonic
# LATEX_COMPILER=pdflatex
# TECTONIC_PATH=C:/path/to/tectonic.exe

# Optional: LangSmith Tracing (for debugging LangChain)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_PROJECT=jobwriterai
