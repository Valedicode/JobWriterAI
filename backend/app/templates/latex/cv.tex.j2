{% endfor %}
\end{itemize}
{% else %}
{% for entry in block.entries %}
{% for r in entry.rows %}
{% if r.bold %}\textbf{ {{- r.left | latex_escape -}} }{% else %}{{ r.left | latex_escape }}{% endif %}{% if r.right %} \hfill {{ r.right | latex_escape }}{% endif %}{% if not loop.last %} \\{% endif %}

{% endfor %}
{% if entry.bullets %}
\begin{itemize}[noitemsep, topsep=1pt, partopsep=0pt, parsep=0pt]
{% for bullet in entry.bullets %}
    \item {{ bullet | latex_escape }}
{% endfor %}
\end{itemize}
{% endif %}
{% if not loop.last %}
\vspace{ {{- layout.entry_gap -}} }

{% endif %}
{% endfor %}
