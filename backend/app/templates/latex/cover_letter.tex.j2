% Entry-level cover letter layout (adapted for Tectonic / pdfLaTeX; no custom fonts).
\documentclass[11pt,a4paper]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage[margin=1cm]{geometry}
\usepackage{iftex}
\ifPDFTeX
% pdfLaTeX: 8-bit T1 fonts. cmap (loaded first) and lmodern map the glyphs back
% to Unicode, so the PDF's text layer is searchable (ATS parsers read it).
\usepackage{cmap}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{lmodern}
\fi
% XeTeX / Tectonic use Unicode fonts by default; T1 there drops dashes and
% prints the sharp s as SS, so no font encoding is set for them.
\usepackage{xcolor}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage{setspace}
\usepackage{ragged2e}

\definecolor{UI_blue}{RGB}{32, 64, 151}
\definecolor{HF_color}{RGB}{179, 179, 179}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\parindent}{0pt}
{% raw %}\rfoot{{\color{HF_color} \thepage\ of\ 1, Updated \today}}{% endraw %}

\begin{document}

\begin{center}
    \begin{minipage}[b]{0.24\textwidth}
        \raggedright
        {% if phone %}\large {{ phone | latex_escape }} \\{% endif %}
        {% if email %}\large \href{mailto:{{ email }}}{ {{- email | latex_escape -}} }{% endif %}
    \end{minipage}%
    \begin{minipage}[b]{0.5\textwidth}
        \centering
        {\Huge {{ name | latex_escape }}} \\[0.1cm]
        {% if target_job %}{\color{UI_blue}\Large {{ target_job | latex_escape }}}{% endif %}
    \end{minipage}%
    \begin{minipage}[b]{0.24\textwidth}
        \raggedleft\large
        {% if link_1_url %}\href{ {{- link_1_url | latex_url -}} }{ {{- link_1_label | latex_escape -}} } \\{% endif %}
        {% if link_2_url %}\href{ {{- link_2_url | latex_url -}} }{ {{- link_2_label | latex_escape -}} }{% endif %}
    \end{minipage}

    \vspace{-0.15cm}
    {\color{UI_blue}\hrulefill}
\end{center}

\justifying
\setlength{\parskip}{12pt}
\vspace{0.2cm}

\begin{center}
    {\color{UI_blue}\Large {{ document_title | latex_escape }}}
\end{center}

{{ date_label | latex_escape }} {{ current_date | latex_escape }}\par
\vspace{-0.1cm}
{{ salutation | latex_escape }}\par

{% for paragraph in paragraphs %}
{{ paragraph | latex_escape }}\par
{% endfor %}

\vspace{0.5cm}
\raggedright
{{ sign_off | latex_escape }} \\
{{ name | latex_escape }} \\
{% if phone %}{{ phone | latex_escape }} \\{% endif %}
{% if email %}\href{mailto:{{ email }}}{ {{- email | latex_escape -}} }{% endif %}

\end{document}
